[Unit]
Description=ADAMO 999 marketplace synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=adamo
Group=adamo
WorkingDirectory=/srv/adamo/current
Environment=NODE_ENV=production
Environment=HOME=/home/adamo
EnvironmentFile=/srv/adamo/shared/.env.production
ExecStart=/usr/bin/node scripts/sync-999.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
